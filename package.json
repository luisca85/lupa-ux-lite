{
  "name": "lupa-ux",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "preview": "vite build && wrangler pages dev dist --port 8788",
    "check": "node scripts/check-syntax.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:e2e": "vite build && playwright test",
    "db:migrate:local": "wrangler d1 migrations apply lupaux --local",
    "db:migrate:remote": "wrangler d1 migrations apply lupaux --remote"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "wrangler": "4.86.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
